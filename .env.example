# Server
PORT=5000
NODE_ENV=development

# MongoDB — use either local or Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/technician_app

# JWT — use a long random secret in production (min 32 chars)
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloudinary (technician work-proof image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── SMTP (Email Notifications) ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="TechBes <your_email@gmail.com>"
MAIL_FROM="TechBes <your_email@gmail.com>"

# ── Twilio (SMS + WhatsApp Notifications) ────────────────────────────────────
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SMS_FROM=your_twilio_phone_number
TWILIO_WA_FROM=your_twilio_whatsapp_number

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Set to a single line JSON string with double quotes escaped, or use local serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your_project_id","private_key":"your_private_key_with_escaped_newlines","client_email":"your_client_email"}

# ── AI Services (Google Gemini) ──────────────────────────────────────────────
GEMINI_API_KEY=your_google_gemini_api_key

# ── Route & Map APIs ──────────────────────────────────────────────────────────
OPENROUTE_SERVICE_API_KEY=your_openroute_service_api_key

# ── Feature Flags & Debug Options ─────────────────────────────────────────────
OTP_DEBUG=false
CCTV_TEST_PAYMENT=true
